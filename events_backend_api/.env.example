# Database connection (async SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres

# JWT signing secret (MUST be set securely in production)
JWT_SECRET=CHANGE_ME

# Optional JWT fields
JWT_ISSUER=event-hub-platform
JWT_AUDIENCE=event-hub-platform
ACCESS_TOKEN_EXP_MINUTES=10080
